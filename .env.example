# Copie solamente los nombres necesarios a variables del proceso/servicio.
# Este archivo no contiene valores reales y la aplicación NO carga archivos .env.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7016;http://localhost:5016
ConnectionStrings__FirmaOperaCloud=Server=SERVIDOR;Database=BASE_UAT;User Id=USUARIO;Password=CAMBIAR;Encrypt=True;TrustServerCertificate=False
OperaCloud__GatewayUrl=https://HOST-UAT
OperaCloud__TokenPath=/oauth/v1/tokens
OperaCloud__AppKey=CAMBIAR
OperaCloud__ClientId=CAMBIAR
OperaCloud__ClientSecret=CAMBIAR
OperaCloud__EnterpriseId=CAMBIAR
OperaCloud__Scope=CAMBIAR
OperaCloud__DefaultHotelId=VINV
OperaCloud__AllowAccompanyingGuestWrites=false
OperaCloud__HttpTimeoutSeconds=60
Database__ApplyMigrations=false
Security__SessionMinutes=60
Ocr__EvidenceRetentionDays=365
BootstrapAdmin__Password=SOLO-PARA-UNA-BASE-NUEVA
KEY_VAULT_URI=
DATA_PROTECTION_KEYS_PATH=
